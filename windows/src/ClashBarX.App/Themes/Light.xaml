<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色主题：M2-M4 既有视觉的色板化 -->
    <SolidColorBrush x:Key="ThemeWindowBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ThemeEditorBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeTextBrush" Color="#1F2328" />
    <SolidColorBrush x:Key="ThemeSecondaryTextBrush" Color="#5E6B78" />
    <SolidColorBrush x:Key="ThemeMutedTextBrush" Color="#8A93A0" />
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="#DDD" />
    <SolidColorBrush x:Key="ThemeRowBorderBrush" Color="#EAEAEA" />
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#0B6BCB" />
    <SolidColorBrush x:Key="ThemeSuccessBrush" Color="#1B7F3B" />
    <SolidColorBrush x:Key="ThemeWarningBrush" Color="#B7791F" />
    <SolidColorBrush x:Key="ThemeErrorBrush" Color="#C0392B" />
</ResourceDictionary>
