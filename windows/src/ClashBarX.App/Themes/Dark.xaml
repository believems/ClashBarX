<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题 -->
    <SolidColorBrush x:Key="ThemeWindowBrush" Color="#1E1E22" />
    <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#26262B" />
    <SolidColorBrush x:Key="ThemeEditorBrush" Color="#2B2B30" />
    <SolidColorBrush x:Key="ThemeTextBrush" Color="#E6E6EA" />
    <SolidColorBrush x:Key="ThemeSecondaryTextBrush" Color="#9AA5B1" />
    <SolidColorBrush x:Key="ThemeMutedTextBrush" Color="#71767F" />
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="#3A3A40" />
    <SolidColorBrush x:Key="ThemeRowBorderBrush" Color="#333338" />
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#4C9EFF" />
    <SolidColorBrush x:Key="ThemeSuccessBrush" Color="#57B866" />
    <SolidColorBrush x:Key="ThemeWarningBrush" Color="#D9A44A" />
    <SolidColorBrush x:Key="ThemeErrorBrush" Color="#E06C5F" />
</ResourceDictionary>
