<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ClashBarX.Core\ClashBarX.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 托盘图标（与 macOS 菜单栏同源资产，由 scripts/generate-app-icon.ps1 生成） -->
    <Resource Include="Assets\tray.ico" />
    <Resource Include="Assets\tray-run.ico" />
    <Resource Include="Assets\tray-sleep.ico" />
    <Resource Include="Assets\tray-tun.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClashBarX.App.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- JobObjectGuard 的 LibraryImport 源生成器需要（生成器内部使用 unsafe） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- exe 文件图标（由 scripts/generate-app-icon.ps1 生成，与托盘图标同源设计） -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
