<Window x:Class="ClashBarX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClashBarX.App"
        mc:Ignorable="d"
        Title="ClashBarX" Height="520" Width="720"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBlock x:Name="CoreStatusText"
                       Text="内核未启动"
                       FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <ToggleButton x:Name="SystemProxyToggle"
                          Content="系统代理"
                          Margin="12,0,0,0"
                          Padding="8,3"
                          VerticalAlignment="Center" />
        </StackPanel>

        <!-- 订阅管理（M2-3）：URL 导入 + 配置列表切换/删除 -->
        <GroupBox DockPanel.Dock="Top" Header="订阅" Margin="0,8,0,0" Padding="8">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button x:Name="ImportButton"
                            DockPanel.Dock="Right"
                            Content="导入"
                            Padding="10,2"
                            MinWidth="60"
                            Click="OnImportClick" />
                    <TextBox x:Name="SubscriptionUrlBox"
                             VerticalContentAlignment="Center"
                             Padding="4,2" />
                </DockPanel>
                <ListBox x:Name="ConfigFilesBox"
                         MinHeight="72"
                         MaxHeight="150"
                         SelectionMode="Single" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button Content="启用"
                            Padding="10,2"
                            MinWidth="60"
                            Margin="0,0,8,0"
                            Click="OnEnableClick" />
                    <Button Content="删除"
                            Padding="10,2"
                            MinWidth="60"
                            Click="OnRemoveClick" />
                </StackPanel>
            </DockPanel>
        </GroupBox>

        <TextBox x:Name="LogTextBox"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas, Microsoft YaHei UI"
                 FontSize="12"
                 Margin="0,10,0,0"
                 Background="#FAFAFA" />
    </DockPanel>
</Window>
