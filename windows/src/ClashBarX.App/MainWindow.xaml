<Window x:Class="ClashBarX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClashBarX.App"
        xmlns:core="clr-namespace:ClashBarX.App.Core"
        xmlns:overrides="clr-namespace:ClashBarX.Core.Overrides;assembly=ClashBarX.Core"
        mc:Ignorable="d"
        Title="ClashBarX" Height="560" Width="760"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <DockPanel Margin="12">
        <!-- 远程机器切换器（源：MenuBarHeaderView.headerConnectionControl——状态点 + 目标下拉 + 管理） -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="MachineStatusDot"
                         Width="8" Height="8"
                         Fill="#B0B7C0"
                         VerticalAlignment="Center"
                         Margin="0,0,6,0"
                         ToolTip="未知" />
                <ComboBox x:Name="MachineTargetSelector"
                          Width="170"
                          FontSize="11"
                          VerticalAlignment="Center"
                          SelectionChanged="OnMachineTargetSelectionChanged" />
                <Button x:Name="ManageMachinesButton"
                        Content="{DynamicResource MachineManage}"
                        FontSize="11"
                        Padding="8,2"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Click="OnManageMachinesClick" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="CoreStatusText"
                           Text="内核未启动"
                           FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <!-- 手动内核生命周期（源：MenuBarHeaderView 的启动/停止/重启动作；远程目标禁用） -->
                <Button x:Name="StartCoreButton"
                        Content="启动内核"
                        FontSize="11"
                        Padding="8,2"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Click="OnCoreStartClick" />
                <Button x:Name="StopCoreButton"
                        Content="停止内核"
                        FontSize="11"
                        Padding="8,2"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Click="OnCoreStopClick" />
                <Button x:Name="RestartCoreButton"
                        Content="重启内核"
                        FontSize="11"
                        Padding="8,2"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Click="OnCoreRestartClick" />
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="MainTabs" Margin="0,8,0,0">
            <!-- 代理（M2-4）：流量摘要 + 分组卡（节点行内联展开） -->
            <TabItem Header="{DynamicResource TabProxy}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="4,6,4,6">
                        <!-- 复制终端代理命令（源：copyLocalProxyCommand chip） -->
                        <Button DockPanel.Dock="Right"
                                Content="复制代理命令"
                                FontSize="11"
                                Padding="8,2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Click="OnCopyProxyCommandClick" />
                        <!-- 分流模式（源：rule/global/direct segmented；PATCH /configs 即时生效） -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <RadioButton Content="规则"
                                         GroupName="ProxyMode"
                                         FontSize="12"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center"
                                         IsChecked="{Binding IsModeRule}" />
                            <RadioButton Content="全局"
                                         GroupName="ProxyMode"
                                         FontSize="12"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center"
                                         IsChecked="{Binding IsModeGlobal}" />
                            <RadioButton Content="直连"
                                         GroupName="ProxyMode"
                                         FontSize="12"
                                         VerticalAlignment="Center"
                                         IsChecked="{Binding IsModeDirect}" />
                        </StackPanel>
                        <TextBlock Text="{Binding TrafficSummary}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding ShowTrafficOverview, Converter={StaticResource BoolToVis}}" />
                    </DockPanel>
                    <!-- TUN 快捷区（源：ProxyTabView.tunModeQuickToggleRow + tunStackMenu：
                         stack 选择 + 开关；权限语义为管理员运行，未提权时开关触发 UAC 重启引导） -->
                    <DockPanel x:Name="TunSectionRoot" DockPanel.Dock="Top" Margin="4,0,4,6">
                        <DockPanel DockPanel.Dock="Right">
                            <CheckBox Content="{DynamicResource ProxyTunToggle}"
                                      FontSize="12"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsTunEnabled}"
                                      IsEnabled="{Binding IsTunToggleEnabled}" />
                            <ComboBox Width="110"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center"
                                      FontSize="12"
                                      ToolTip="{DynamicResource ProxyTunStackHint}"
                                      ItemsSource="{Binding StackOptions}"
                                      SelectedValuePath="Stack"
                                      SelectedValue="{Binding SelectedStack}"
                                      IsEnabled="{Binding IsTunToggleEnabled}">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}" ToolTip="{Binding DisplayText}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                        <TextBlock Text="{DynamicResource ProxyTunMode}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ProxyGroupsList" ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Margin="2,4,2,0"
                                              Padding="4,2"
                                              BorderBrush="#DDD"
                                              BorderThickness="1"
                                              IsExpanded="False">
                                        <Expander.Header>
                                            <DockPanel Margin="0,2">
                                                <Button DockPanel.Dock="Right"
                                                        Content="测速"
                                                        Padding="8,1"
                                                        Margin="6,0,0,0"
                                                        FontSize="11"
                                                        Command="{Binding TestGroupCommand}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding DelayText}"
                                                           Foreground="#5E6B78"
                                                           FontSize="11"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding CurrentNode}"
                                                           Foreground="#5E6B78"
                                                           FontSize="11"
                                                           Margin="10,0,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="220"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Expander.Header>
                                        <!-- 节点行：类型徽章 + 名称 + 延迟 + 单节点测速 -->
                                        <ItemsControl ItemsSource="{Binding Nodes}" Margin="6,2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,1">
                                                        <Button DockPanel.Dock="Right"
                                                                Content="⚡"
                                                                Padding="4,0"
                                                                Margin="6,0,0,0"
                                                                FontSize="11"
                                                                ToolTip="测速"
                                                                Command="{Binding DataContext.TestNodeCommand, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                CommandParameter="{Binding}" />
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding DelayText}"
                                                                   Foreground="#5E6B78"
                                                                   FontSize="11"
                                                                   MinWidth="52"
                                                                   TextAlignment="Right"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock DockPanel.Dock="Left"
                                                                   Text="{Binding NodeType}"
                                                                   Foreground="#8A93A0"
                                                                   FontSize="10"
                                                                   MinWidth="72"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   Cursor="Hand"
                                                                   Background="Transparent"
                                                                   Padding="2,1">
                                                            <TextBlock.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick"
                                                                              Command="{Binding DataContext.SwitchNodeCommand, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                              CommandParameter="{Binding}" />
                                                            </TextBlock.InputBindings>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                            <Setter Property="Foreground" Value="#0B6BCB" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- 规则（M4-1）：列表（目标/类型/策略/规则集统计）+ 类型过滤 + 搜索 + 策略分组 -->
            <TabItem Header="{DynamicResource TabRules}">
                <DockPanel x:Name="RulesRoot" Margin="4,8,4,4">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right"
                                Content="刷新规则集"
                                Padding="10,2"
                                Margin="10,0,0,0"
                                FontSize="11"
                                Command="{Binding RefreshCommand}" />
                        <ToggleButton DockPanel.Dock="Right"
                                      Content="按策略分组"
                                      Padding="10,2"
                                      FontSize="11"
                                      IsChecked="{Binding GroupByPolicy}" />
                        <TextBlock Text="{Binding StatsText}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <ComboBox DockPanel.Dock="Right"
                                  Width="110"
                                  Margin="8,0,0,0"
                                  ItemsSource="{Binding PolicyOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding PolicyFilter}" />
                        <ComboBox DockPanel.Dock="Right"
                                  Width="84"
                                  ItemsSource="{Binding TypeFilterOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding TypeFilter}" />
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Padding="6,2"
                                 Margin="0,0,8,0" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding CountText}"
                               Foreground="#5E6B78"
                               FontSize="11"
                               Margin="0,0,0,4" />
                    <!-- 规则覆写（M4-1b：内嵌卡片——「列表是查看，覆写是操作」；源 OverrideTabView） -->
                    <Border DockPanel.Dock="Bottom"
                            x:Name="OverrideCardRoot"
                            Margin="0,6,0,0"
                            Padding="8"
                            BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="#FAFAFA">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right"
                                          Content="启用"
                                          FontSize="12"
                                          IsChecked="{Binding IsEnabled}" />
                                <TextBlock Text="规则覆写"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding DisabledHint}"
                                       Foreground="#5E6B78"
                                       FontSize="10"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Margin="0,6,0,0"
                                        Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}">
                                <!-- 三文件区行（同一时间只展开一个） -->
                                <Button Command="{Binding ToggleFileCommand}"
                                        CommandParameter="{x:Static overrides:RuleOverrideFile.Prepend}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="2,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↑" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="前置规则（插在订阅 rules 最前）" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Counts.Prepend, StringFormat={}{0} 条}" Foreground="#5E6B78" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ToggleFileCommand}"
                                        CommandParameter="{x:Static overrides:RuleOverrideFile.Append}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="2,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↓" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="追加规则（插在 MATCH/FINAL 之前）" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Counts.Append, StringFormat={}{0} 条}" Foreground="#5E6B78" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ToggleFileCommand}"
                                        CommandParameter="{x:Static overrides:RuleOverrideFile.RuleProviders}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="2,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="≡" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="规则集（同名以覆写为准）" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Counts.RuleProviders, StringFormat={}{0} 个}" Foreground="#5E6B78" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <!-- 编辑器（展开时显示，固定高 180；源：PlainTextEditor editorHeight） -->
                                <Grid Margin="0,6,0,0"
                                      Visibility="{Binding HasExpandedFile, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox Text="{Binding CurrentDraft, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             FontFamily="Consolas, Microsoft YaHei UI"
                                             FontSize="12"
                                             Height="180"
                                             Background="White"
                                             BorderBrush="#CCC" />
                                    <StackPanel Grid.Row="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,4,0,0">
                                        <Button Content="还原"
                                                Padding="10,2"
                                                FontSize="11"
                                                Margin="0,0,8,0"
                                                Command="{Binding RevertCommand}"
                                                IsEnabled="{Binding IsDirty}" />
                                        <Button Content="保存"
                                                Padding="10,2"
                                                FontSize="11"
                                                Command="{Binding SaveCommand}"
                                                IsEnabled="{Binding IsDirty}" />
                                    </StackPanel>
                                </Grid>
                                <!-- 状态行 -->
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Text="{Binding StatusText}"
                                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#1B7F3B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusLevel}" Value="error">
                                                    <Setter Property="Foreground" Value="#C0392B" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusLevel}" Value="info">
                                                    <Setter Property="Foreground" Value="#5E6B78" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- 操作按钮 -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Padding="10,2"
                                            FontSize="11"
                                            MinWidth="88"
                                            HorizontalAlignment="Left"
                                            Command="{Binding ApplyNowCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="立即应用" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsApplying}" Value="True">
                                                        <Setter Property="Content" Value="应用中…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="打开覆写目录"
                                            Padding="10,2"
                                            FontSize="11"
                                            Margin="8,0,0,0"
                                            Command="{Binding OpenFolderCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type core:RuleGroupHeaderViewModel}">
                                    <Button Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Policy}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="2,4"
                                            Margin="0,4,0,2">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Foreground="#5E6B78"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="{Binding Policy, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Count, Mode=OneWay, StringFormat=· {0} 条}" Foreground="#5E6B78" />
                                            </TextBlock>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type core:RuleRowViewModel}">
                                    <Border Padding="2,4" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Target}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TypeText}"
                                                           Foreground="#8A93A0"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PolicyText}"
                                                       FontSize="11"
                                                       Foreground="#5E6B78"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding StatsText}"
                                                       FontSize="11"
                                                       Foreground="#8A93A0"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- 连接（M3-1/M3-4）：列表（host/规则/链路/上下行速率）+ 三维度流量统计 -->
            <TabItem Header="{DynamicResource TabConnections}">
                <Grid x:Name="ConnectionsRoot" Margin="4,8,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 视图切换：连接 / 统计（源：connectionsStore.showsStatistics segmented） -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton GroupName="ConnectionView"
                                     Content="连接"
                                     IsChecked="True"
                                     FontSize="12"
                                     VerticalAlignment="Center" />
                        <RadioButton GroupName="ConnectionView"
                                     Content="统计"
                                     IsChecked="{Binding ShowsStatistics}"
                                     Margin="12,0,0,0"
                                     FontSize="12"
                                     VerticalAlignment="Center" />
                        <ComboBox Width="76"
                                  Margin="16,0,0,0"
                                  ItemsSource="{Binding DimensionOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding StatisticsDimension}"
                                  Visibility="{Binding ShowsStatistics, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding StatisticsHint}"
                                   Foreground="#8A93A0"
                                   FontSize="10"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding ShowsStatistics, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <DockPanel Grid.Row="1" Visibility="{Binding ShowsList, Converter={StaticResource BoolToVis}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right"
                                Content="关闭全部"
                                Padding="8,2"
                                Margin="8,0,0,0"
                                FontSize="11"
                                Command="{Binding CloseAllConnectionsCommand}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding SummaryText}"
                                   Foreground="#5E6B78"
                                   FontSize="11"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                        <ToggleButton DockPanel.Dock="Right"
                                      Content="降序"
                                      Padding="8,2"
                                      Margin="8,0,0,0"
                                      FontSize="11"
                                      IsChecked="{Binding IsSortDescending}" />
                        <ComboBox DockPanel.Dock="Right"
                                  Width="104"
                                  Margin="8,0,0,0"
                                  ItemsSource="{Binding SortKeyOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SortKey}" />
                        <ComboBox DockPanel.Dock="Left"
                                  Width="76"
                                  ItemsSource="{Binding TransportFilterOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding TransportFilter}" />
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Padding="6,2"
                                 Margin="8,0,8,0" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ConnectionsList" ItemsSource="{Binding Connections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4,5" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right"
                                                    Content="✕"
                                                    Padding="5,0"
                                                    Margin="8,0,0,0"
                                                    FontSize="11"
                                                    ToolTip="关闭连接"
                                                    Command="{Binding CloseConnectionCommand}"
                                                    CommandParameter="{Binding}" />
                                            <StackPanel>
                                                <!-- 行1：host + 规则 -->
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Text="{Binding Rule}"
                                                               Foreground="#5E6B78"
                                                               FontSize="11"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Host}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <!-- 行2：时间 / 网络 / ↑速率 / ↓速率 / ↑累计 / ↓累计 -->
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Started}" Foreground="#5E6B78" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Network}" Foreground="#5E6B78" FontSize="11" Margin="10,0,0,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding UploadRate}" FontSize="11" Foreground="#0B6BCB" Margin="10,0,0,0" />
                                                    <TextBlock Grid.Column="3" Text="{Binding DownloadRate}" FontSize="11" Foreground="#1B7F3B" Margin="10,0,0,0" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Upload}" FontSize="11" Foreground="#8A93A0" Margin="10,0,0,0" TextAlignment="Right" />
                                                    <TextBlock Grid.Column="5" Text="{Binding Download}" FontSize="11" Foreground="#8A93A0" Margin="10,0,0,0" TextAlignment="Right" />
                                                </Grid>
                                                <!-- 行3：链路 -->
                                                <TextBlock Text="{Binding Chain}"
                                                           Foreground="#8A93A0"
                                                           FontSize="10"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </DockPanel>
                    <!-- 统计视图（源：TrafficStatisticsView——名称/合计/上下行） -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding ShowsStatistics, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding StatisticsRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4,5" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal"
                                                        MinWidth="200">
                                                <TextBlock Text="合计"
                                                           FontSize="10"
                                                           Foreground="#8A93A0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding TotalText}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding UploadText}"
                                                           FontSize="11"
                                                           Foreground="#0B6BCB"
                                                           Margin="16,0,0,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DownloadText}"
                                                           FontSize="11"
                                                           Foreground="#1B7F3B"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 日志（M3-2）：mihomo WS 流 + 等级过滤 + 搜索 + 渲染上限 -->
            <TabItem Header="{DynamicResource TabLogs}">
                <DockPanel x:Name="LogsRoot" Margin="4,8,4,4">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right"
                                Content="清空"
                                Padding="10,2"
                                MinWidth="52"
                                Margin="8,0,0,0"
                                FontSize="11"
                                Command="{Binding ClearAllCommand}" />
                        <!-- 内核日志等级快捷入口（源：日志页级别菜单直接改内核设置） -->
                        <ComboBox DockPanel.Dock="Right"
                                  Width="90"
                                  Margin="8,0,0,0"
                                  FontSize="11"
                                  ItemsSource="{Binding LogLevelOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding LogLevel}" />
                        <Button DockPanel.Dock="Right"
                                Content="复制全部"
                                Padding="10,2"
                                FontSize="11"
                                Click="OnCopyLogsClick" />
                        <!-- 来源过滤（源：logsSourceFilterButtons——空集 = 全部） -->
                        <CheckBox Content="ClashBarX"
                                  IsChecked="{Binding IsClashBarSourceSelected}"
                                  VerticalAlignment="Center"
                                  FontSize="12" />
                        <CheckBox Content="Mihomo"
                                  IsChecked="{Binding IsMihomoSourceSelected}"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center"
                                  FontSize="12" />
                        <CheckBox Content="错误"
                                  IsChecked="{Binding IsErrorSelected}"
                                  Margin="14,0,0,0"
                                  VerticalAlignment="Center"
                                  FontSize="12" />
                        <CheckBox Content="警告"
                                  IsChecked="{Binding IsWarningSelected}"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center"
                                  FontSize="12" />
                        <CheckBox Content="信息"
                                  IsChecked="{Binding IsInfoSelected}"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center"
                                  FontSize="12" />
                        <TextBlock Text="{Binding MatchedCountText}"
                                   Foreground="#5E6B78"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox DockPanel.Dock="Top"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             Padding="6,2"
                             Margin="0,0,0,4" />
                    <ListBox ItemsSource="{Binding VisibleLogs}"
                             FontFamily="Consolas, Microsoft YaHei UI"
                             FontSize="12"
                             Background="#FAFAFA"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,1">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="{Binding Timestamp}"
                                               Foreground="#8A93A0"
                                               FontSize="11"
                                               VerticalAlignment="Top" />
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="{Binding Source}"
                                               FontSize="11"
                                               Foreground="#5E6B78"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding Message}"
                                               TextWrapping="Wrap"
                                               Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="error">
                                                        <Setter Property="Foreground" Value="#C0392B" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="warning">
                                                        <Setter Property="Foreground" Value="#B7791F" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <!-- 网络（M4-2）：系统代理/绕过列表 + 自动代理守护 + 订阅管理 -->
            <TabItem Header="{DynamicResource TabNetwork}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,8,4,4">
                        <!-- 系统代理 + 绕过列表（源：SystemTabView 绕过区块 + 快捷开关） -->
                        <Border x:Name="SystemProxySectionRoot"
                                Padding="8"
                                BorderBrush="#DDD"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="#FAFAFA"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right"
                                              Content="启用"
                                              FontSize="12"
                                              IsChecked="{Binding IsEnabled}" />
                                    <TextBlock Text="系统代理"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="绕过列表（写入 Windows 代理例外，不在列表内的地址才走代理）"
                                           FontSize="11"
                                           Foreground="#5E6B78"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Exceptions}" Margin="16,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,1">
                                                <Button DockPanel.Dock="Right"
                                                        Content="✕"
                                                        Padding="5,0"
                                                        FontSize="11"
                                                        ToolTip="移除"
                                                        Command="{Binding DataContext.RemoveExceptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="4,2"
                                                         VerticalContentAlignment="Center" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="16,4,0,0">
                                    <Button DockPanel.Dock="Right"
                                            Content="新增"
                                            Padding="8,1"
                                            FontSize="11"
                                            Command="{Binding AddExceptionCommand}"
                                            IsEnabled="{Binding CanAddException}" />
                                    <TextBox Text="{Binding NewException, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"
                                             Padding="4,2" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="16,8,0,0">
                                    <Button Content="恢复默认"
                                            Padding="10,2"
                                            FontSize="11"
                                            Margin="0,0,8,0"
                                            Command="{Binding ResetExceptionsCommand}" />
                                    <Button Content="保存"
                                            Padding="10,2"
                                            FontSize="11"
                                            Command="{Binding SaveExceptionsCommand}"
                                            IsEnabled="{Binding HasPendingChanges}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- 自动代理守护（M3-3 区块挪入网络页；开关 + 周期 + 立即检查 + 结果反馈行） -->
                        <Border x:Name="GuardSettingsRoot"
                                Padding="8"
                                BorderBrush="#DDD"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="#FAFAFA"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding IsGuardEnabled}"
                                          Content="自动代理守护（自动切换可用节点）"
                                          FontWeight="SemiBold"
                                          FontSize="12" />
                                <StackPanel Margin="16,8,0,0"
                                            Visibility="{Binding IsGuardEnabled, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="探测周期（秒）" VerticalAlignment="Center" FontSize="12" />
                                        <TextBox Text="{Binding IntervalText}"
                                                 Width="64"
                                                 Margin="8,0,0,0"
                                                 Padding="4,2"
                                                 VerticalContentAlignment="Center" />
                                    </StackPanel>
                                    <Button Margin="0,6,0,0"
                                            Padding="10,2"
                                            MinWidth="96"
                                            HorizontalAlignment="Left"
                                            Command="{Binding CheckNowCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="立即检查" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProbing}" Value="True">
                                                        <Setter Property="Content" Value="检查中…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Margin="0,8,0,0"
                                               FontSize="12"
                                               Text="{Binding OutcomeText}"
                                               Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVis}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#1B7F3B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OutcomeLevel}" Value="warning">
                                                        <Setter Property="Foreground" Value="#B7791F" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding DisabledHint}"
                                           Foreground="#5E6B78"
                                           FontSize="11"
                                           Margin="16,8,0,0"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGuardEnabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <!-- 订阅管理（M2-3 区块挪入网络页；远程目标时整体只读） -->
                        <Border x:Name="SubscriptionSectionRoot"
                                Padding="8"
                                BorderBrush="#DDD"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="#FAFAFA">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock x:Name="RemoteReadonlyHint"
                                               DockPanel.Dock="Right"
                                               Text="{DynamicResource MachineRemoteReadonly}"
                                               FontSize="11"
                                               Foreground="#B45309"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                    <TextBlock Text="订阅"
                                               FontWeight="SemiBold"
                                               FontSize="12" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button x:Name="ImportButton"
                                            DockPanel.Dock="Right"
                                            Content="导入"
                                            Padding="10,2"
                                            MinWidth="60"
                                            Click="OnImportClick" />
                                    <TextBox x:Name="SubscriptionUrlBox"
                                             VerticalContentAlignment="Center"
                                             Padding="4,2" />
                                </DockPanel>
                                <ListBox x:Name="ConfigFilesBox"
                                         MinHeight="72"
                                         MaxHeight="200" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                    <!-- 远程订阅更新（源：ProxyTabView 订阅行刷新/更新全部） -->
                                    <Button Content="更新"
                                            Padding="10,2"
                                            MinWidth="60"
                                            Margin="0,0,8,0"
                                            Click="OnRefreshSubscriptionClick" />
                                    <Button Content="更新全部"
                                            Padding="10,2"
                                            MinWidth="72"
                                            Margin="0,0,8,0"
                                            Click="OnRefreshAllSubscriptionsClick" />
                                    <Button Content="启用"
                                            Padding="10,2"
                                            MinWidth="60"
                                            Margin="0,0,8,0"
                                            Click="OnEnableClick" />
                                    <Button Content="删除"
                                            Padding="10,2"
                                            MinWidth="60"
                                            Click="OnRemoveClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 设置（M4-3）：外观 / 语言 / 开机自启 / 流量概览 -->
            <TabItem Header="{DynamicResource TabSettings}">
                <Border x:Name="SettingsRoot"
                        Padding="8"
                        BorderBrush="#DDD"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="#FAFAFA"
                        Margin="4,8,4,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        MinWidth="380">
                    <StackPanel>
                        <TextBlock Text="外观"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Margin="0,0,0,6" />
                        <ComboBox Width="180"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding AppearanceOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding AppearanceMode}" />

                        <TextBlock Text="语言"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Margin="0,14,0,6" />
                        <ComboBox Width="180"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding LanguageOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Language}" />

                        <TextBlock Text="开机自启"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Margin="0,14,0,6" />
                        <CheckBox Content="登录 Windows 时自动启动 ClashBarX"
                                  FontSize="12"
                                  IsChecked="{Binding LaunchAtLogin}" />
                        <TextBlock Text="写入注册表失败，已回滚"
                                   FontSize="11"
                                   Foreground="#C0392B"
                                   Margin="18,4,0,0"
                                   Visibility="{Binding LaunchAtLoginFailed, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="流量概览"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Margin="0,14,0,6" />
                        <CheckBox Content="在代理页顶部显示实时速率与连接摘要"
                                  FontSize="12"
                                  IsChecked="{Binding ShowTrafficOverview}" />

                        <!-- 核心设置（源：SystemTabView 核心设置区；经 PATCH /configs 即时生效） -->
                        <Border Padding="8"
                                BorderBrush="#DDD"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,16,0,0"
                                DataContext="{Binding CoreSettings}">
                            <StackPanel>
                                <TextBlock Text="核心设置"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Margin="0,0,0,6" />
                                <CheckBox Content="允许局域网连接（allow-lan）"
                                          FontSize="12"
                                          IsChecked="{Binding AllowLan}" />
                                <CheckBox Content="IPv6"
                                          FontSize="12"
                                          Margin="0,4,0,0"
                                          IsChecked="{Binding Ipv6}" />
                                <CheckBox Content="TCP 并发（tcp-concurrent）"
                                          FontSize="12"
                                          Margin="0,4,0,0"
                                          IsChecked="{Binding TcpConcurrent}" />
                                <CheckBox Content="切换节点时关闭旧连接"
                                          FontSize="12"
                                          Margin="0,4,0,0"
                                          IsChecked="{Binding CloseConnections}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="日志等级"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <ComboBox Width="110"
                                              Margin="10,0,0,0"
                                              ItemsSource="{Binding LogLevelOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding LogLevel}" />
                                </StackPanel>

                                <!-- 代理端口五项（750ms 防抖自动保存） -->
                                <TextBlock Text="代理端口（修改后自动保存）"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Margin="0,14,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="混合端口" FontSize="12" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MixedPortText, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" Margin="0,2,8,2" VerticalContentAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="HTTP 代理端口" FontSize="12" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" Margin="0,2,0,2" VerticalContentAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="SOCKS5 端口" FontSize="12" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SocksPortText, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" Margin="0,2,8,2" VerticalContentAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="透明代理端口" FontSize="12" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding RedirPortText, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" Margin="0,2,0,2" VerticalContentAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="TProxy 端口" FontSize="12" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TproxyPortText, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" Margin="0,2,8,2" VerticalContentAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 维护（源：SystemTabView 维护区；GEO 热更新 + 内核自升级） -->
                        <TextBlock Text="维护"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Margin="0,16,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <Button Padding="10,2"
                                    FontSize="11"
                                    MinWidth="96"
                                    Command="{Binding UpgradeGeoCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="更新 GEO 数据" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMaintaining}" Value="True">
                                                <Setter Property="Content" Value="执行中…" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Padding="10,2"
                                    FontSize="11"
                                    MinWidth="96"
                                    Margin="8,0,0,0"
                                    Command="{Binding UpgradeCoreCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="升级内核" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMaintaining}" Value="True">
                                                <Setter Property="Content" Value="执行中…" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Padding="10,2"
                                    FontSize="11"
                                    Margin="8,0,0,0"
                                    Command="{Binding FlushFakeIPCommand}"
                                    Content="清 FakeIP 缓存" />
                            <Button Padding="10,2"
                                    FontSize="11"
                                    Margin="8,0,0,0"
                                    Command="{Binding FlushDNSCommand}"
                                    Content="清 DNS 缓存" />
                            <Button Padding="10,2"
                                    FontSize="11"
                                    Margin="8,0,0,0"
                                    Content="打开内核目录"
                                    Click="OnOpenCoreDirectoryClick" />
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="{Binding MaintenanceStatusText}"
                                   Visibility="{Binding HasMaintenanceStatus, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1B7F3B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MaintenanceStatusLevel}" Value="error">
                                            <Setter Property="Foreground" Value="#C0392B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
