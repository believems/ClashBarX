<Window x:Class="ClashBarX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClashBarX.App"
        mc:Ignorable="d"
        Title="ClashBarX" Height="440" Width="640"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBlock x:Name="CoreStatusText"
                       Text="内核未启动"
                       FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <ToggleButton x:Name="SystemProxyToggle"
                          Content="系统代理"
                          Margin="12,0,0,0"
                          Padding="8,3"
                          VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top"
                   Margin="0,6,0,10"
                   Foreground="#666"
                   TextWrapping="Wrap"
                   Text="M2 骨架：托盘常驻 + 内核 sidecar + API 轮询 + 系统代理开关。关闭本窗口即最小化到托盘；退出请使用托盘菜单。" />
        <TextBox x:Name="LogTextBox"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas, Microsoft YaHei UI"
                 FontSize="12"
                 Background="#FAFAFA" />
    </DockPanel>
</Window>
