<Window x:Class="ClashBarX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClashBarX.App"
        xmlns:core="clr-namespace:ClashBarX.App.Core"
        xmlns:overrides="clr-namespace:ClashBarX.Core.Overrides;assembly=ClashBarX.Core"
        mc:Ignorable="d"
        Title="ClashBarX" Height="660" Width="760"
        WindowStyle="None"
        Background="{DynamicResource ThemeWindowBrush}"
        WindowStartupLocation="CenterScreen">
    <!-- 自绘标题栏（原型 titlebar 语义：LOGO→应用菜单 + 应用名 + 窗控按钮）；
         CaptionHeight=0 全自绘，ResizeBorderThickness 保留边缘缩放 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- 自绘标题栏窗控按钮（扁平、悬停浅灰底） -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <core:InverseBoolConverter x:Key="InverseBool" />
        <core:InverseBoolToVisibilityConverter x:Key="InvertVis" />
        <core:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <core:StringToVisibilityConverter x:Key="StringToVis" />
    </Window.Resources>
    <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
    <DockPanel>
        <!-- 自绘标题栏：LOGO（应用菜单）+ 应用名 | 最小化/最大化/关闭；拖动移窗、双击最大化/还原 -->
        <DockPanel x:Name="TitleBarRoot"
                   DockPanel.Dock="Top"
                   Height="34"
                   Background="{DynamicResource ThemeWindowBrush}"
                   MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="—"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTip="{DynamicResource TitleBarMinimize}"
                        Click="OnMinimizeClick" />
                <Button Content="▢"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTip="{DynamicResource TitleBarMaximize}"
                        Click="OnMaximizeClick" />
                <Button Content="✕"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTip="{DynamicResource TitleBarClose}"
                        Click="OnCloseClick" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button x:Name="AppMenuButton"
                        Click="OnAppMenuClick"
                        AutomationProperties.Name="{DynamicResource AppMenuTooltip}"
                        ToolTip="{DynamicResource AppMenuTooltip}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="2"
                        VerticalAlignment="Center"
                        Cursor="Hand">
                    <Image Source="/Assets/tray.ico"
                           Width="20" Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom" PlacementTarget="{Binding ElementName=AppMenuButton}">
                            <MenuItem Header="{DynamicResource AppMenuAbout}" Click="OnAppAboutClick" />
                            <MenuItem Header="{DynamicResource AppMenuCheckUpdate}" Click="OnAppCheckUpdateClick" />
                            <Separator />
                            <MenuItem Header="{DynamicResource AppMenuHideWindow}" Click="OnAppHideWindowClick" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <TextBlock Text="ClashBarX"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextBrush}"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0" />
            </StackPanel>
        </DockPanel>
        <DockPanel Margin="12">
        <!-- 底部状态栏：状态+版本 | 速率 | 连接+内存（右对齐；头部状态文本全部下沉至此）。
             须先于 TabControl 声明（dock Bottom）——TabControl 作为最后子元素 Fill 剩余空间；
             声明在 TabControl 之后会被 LastChildFill 拉伸成右侧竖条（真机实测） -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusStripText" Text="{DynamicResource CoreStatusDefault}" FontSize="11" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusStripRate" FontSize="11" Foreground="#5E6B78" Text="—" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatusStripMisc" FontSize="11" Foreground="#5E6B78" />
            </StatusBarItem>
        </StatusBar>

        <!-- 头部行：左上角 App 图标（应用菜单）+ 内核状态点 + 互斥内核按钮（左）；
             远程机器切换器（源：MenuBarHeaderView.headerConnectionControl）右置 -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="MachineStatusDot"
                         Width="8" Height="8"
                         Fill="#B0B7C0"
                         VerticalAlignment="Center"
                         Margin="0,0,6,0"
                         ToolTip="{DynamicResource MachineTooltipUnknown}" />
                <ComboBox x:Name="MachineTargetSelector"
                          Width="170"
                          FontSize="11"
                          VerticalAlignment="Center"
                          SelectionChanged="OnMachineTargetSelectionChanged" />
                <Button x:Name="ManageMachinesButton"
                        Content="{DynamicResource MachineManage}"
                        FontSize="11"
                        Padding="8,2"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Click="OnManageMachinesClick" />
                <!-- WebUI 入口（源：headerControllerWebUIButton——打开 external-ui；未配置时 metacubexd 引导） -->
                <Button Content="{DynamicResource WebUIOpen}"
                        FontSize="11"
                        Padding="8,2"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Click="OnOpenWebUIClick" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <!-- 内核状态点（绿=运行+API 正常 / 黄=运行但 API 未就绪 / 灰=未运行；详情悬停） -->
                <Ellipse x:Name="CoreStatusDot"
                         Width="10" Height="10"
                         Fill="#B0B7C0"
                         Margin="10,0,0,0"
                         VerticalAlignment="Center"
                         ToolTip="{DynamicResource CoreStatusDefault}" />
                <!-- 互斥内核按钮（源：primaryCoreAction 语义——未运行=启动；运行中=停止+重启；远程目标禁用） -->
                <Button x:Name="StartCoreButton"
                        Content="{DynamicResource CoreStart}"
                        FontSize="11"
                        Padding="8,2"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="Visible"
                        Click="OnCoreStartClick" />
                <Button x:Name="StopCoreButton"
                        Content="{DynamicResource CoreStop}"
                        FontSize="11"
                        Padding="8,2"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Click="OnCoreStopClick" />
                <Button x:Name="RestartCoreButton"
                        Content="{DynamicResource CoreRestart}"
                        FontSize="11"
                        Padding="8,2"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Click="OnCoreRestartClick" />
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="MainTabs" Margin="0,8,0,0">
            <!-- 代理（M2-4）：流量摘要 + 分组卡（节点行内联展开） -->
            <TabItem Header="{DynamicResource TabProxy}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="4,6,4,6">
                        <!-- 复制终端代理命令：CMD / PowerShell / Bash 三格式（与托盘二级菜单同源；
                             流量摘要已下沉底部状态栏） -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource ProxyCopyCommand}"
                                       FontSize="11"
                                       Foreground="#5E6B78"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <Button Content="CMD"
                                    FontSize="11"
                                    Padding="8,2"
                                    Click="OnCopyProxyCommandCmdClick" />
                            <Button Content="PowerShell"
                                    FontSize="11"
                                    Padding="8,2"
                                    Margin="6,0,0,0"
                                    Click="OnCopyProxyCommandPowerShellClick" />
                            <Button Content="Bash"
                                    FontSize="11"
                                    Padding="8,2"
                                    Margin="6,0,0,0"
                                    Click="OnCopyProxyCommandBashClick" />
                        </StackPanel>
                        <!-- 分流模式（源：rule/global/direct segmented；PATCH /configs 即时生效） -->
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{DynamicResource ModeRule}"
                                         GroupName="ProxyMode"
                                         FontSize="12"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center"
                                         IsChecked="{Binding IsModeRule}" />
                            <RadioButton Content="{DynamicResource ModeGlobal}"
                                         GroupName="ProxyMode"
                                         FontSize="12"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center"
                                         IsChecked="{Binding IsModeGlobal}" />
                            <RadioButton Content="{DynamicResource ModeDirect}"
                                         GroupName="ProxyMode"
                                         FontSize="12"
                                         VerticalAlignment="Center"
                                         IsChecked="{Binding IsModeDirect}" />
                        </StackPanel>
                    </DockPanel>
                    <!-- TUN 快捷区（源：ProxyTabView.tunModeQuickToggleRow + tunStackMenu：
                         stack 选择 + 开关；权限语义为管理员运行，未提权时开关触发 UAC 重启引导） -->
                    <DockPanel x:Name="TunSectionRoot" DockPanel.Dock="Top" Margin="4,0,4,6">
                        <DockPanel DockPanel.Dock="Right">
                            <CheckBox Content="{DynamicResource ProxyTunToggle}"
                                      FontSize="12"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsTunEnabled}"
                                      IsEnabled="{Binding IsTunToggleEnabled}" />
                            <ComboBox Width="110"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center"
                                      FontSize="12"
                                      ToolTip="{DynamicResource ProxyTunStackHint}"
                                      ItemsSource="{Binding StackOptions}"
                                      SelectedItem="{Binding SelectedStackOption}"
                                      IsEnabled="{Binding IsTunToggleEnabled}">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}" ToolTip="{Binding DisplayText}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                        <TextBlock Text="{DynamicResource ProxyTunMode}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                        <!-- Provider 区（M5-5：源 proxyProvidersSection——可折叠、更新全部、
                             行：节点数/更新时间/到期（<15 天警示）/配额条/healthcheck/刷新） -->
                        <StackPanel x:Name="ProxyProvidersRoot" Margin="2,0,2,4">
                            <StackPanel.Resources>
                                <Style x:Key="ProviderActionStyle" TargetType="Button">
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="Padding" Value="6,1" />
                                    <Setter Property="Margin" Value="4,0,0,0" />
                                </Style>
                            </StackPanel.Resources>
                            <DockPanel Margin="2,4,2,2">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="UpdateAllProvidersButton"
                                            Content="{DynamicResource ProvidersUpdateAll}"
                                            Style="{StaticResource ProviderActionStyle}"
                                            Command="{Binding UpdateAllCommand}"
                                            IsEnabled="{Binding IsRefreshingAll, Converter={StaticResource InverseBool}}" />
                                    <ToggleButton x:Name="ProvidersCollapseToggle"
                                                  IsChecked="{Binding IsCollapsed}"
                                                  FontSize="11"
                                                  Padding="6,1"
                                                  Margin="4,0,0,0"
                                                  Content="▲▼" />
                                </StackPanel>
                                <TextBlock Text="{DynamicResource ProvidersTitle}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Rows}"
                                          Visibility="{Binding IsCollapsed, Converter={StaticResource InverseBoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4"
                                                Background="#FAFAFA" Margin="0,0,0,4" Padding="8,4">
                                            <StackPanel>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Content="⚡"
                                                                Style="{StaticResource ProviderActionStyle}"
                                                                ToolTip="{DynamicResource ProvidersHealthcheck}"
                                                                Command="{Binding DataContext.HealthcheckProviderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding Name}" />
                                                        <Button Content="⟳"
                                                                Style="{StaticResource ProviderActionStyle}"
                                                                ToolTip="{DynamicResource ProvidersRefresh}"
                                                                Command="{Binding DataContext.UpdateProviderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding Name}"
                                                                IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBool}}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                                        <TextBlock FontSize="11"
                                                                   Foreground="#5E6B78"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center">
                                                            <Run Text="{Binding NodeCount, Mode=OneWay}" />
                                                            <Run Text="{DynamicResource ProvidersNodeCount}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding UpdatedText}"
                                                                   FontSize="11"
                                                                   Foreground="#8A93A0"
                                                                   Margin="10,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <StackPanel Margin="2,4,0,0"
                                                            Visibility="{Binding QuotaText, Converter={StaticResource StringToVis}}">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding QuotaText}"
                                                                   FontSize="11"
                                                                   Foreground="#5E6B78"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ExpireText}"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#5E6B78" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ExpiresSoon}" Value="True">
                                                                            <Setter Property="Foreground" Value="#B45309" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DockPanel>
                                                    <!-- 用量比例条（≥90% 红 / ≥75% 黄 / 其余灰；源：usedRatio 条） -->
                                                    <ProgressBar Height="4"
                                                                 Margin="0,4,0,0"
                                                                 Maximum="1"
                                                                 Minimum="0"
                                                                 Value="{Binding UsedRatio, Mode=OneWay, TargetNullValue=0}">
                                                        <ProgressBar.Style>
                                                            <Style TargetType="ProgressBar">
                                                                <Setter Property="Foreground" Value="#5E6B78" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding QuotaLevel}" Value="warn">
                                                                        <Setter Property="Foreground" Value="#B45309" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding QuotaLevel}" Value="critical">
                                                                        <Setter Property="Foreground" Value="#C0392B" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ProgressBar.Style>
                                                    </ProgressBar>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <!-- 分组卡视图开关（源：compactTopIcon 开关组——延迟排序/历史信号条/hidden 分组/测全部/折叠） -->
                        <DockPanel Margin="2,4,2,2">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="TestAllGroupsButton"
                                        Content="{DynamicResource GroupsTestAll}"
                                        FontSize="11"
                                        Padding="8,1"
                                        Command="{Binding TestAllGroupsCommand}"
                                        IsEnabled="{Binding IsTestingAllGroupLatencies, Converter={StaticResource InverseBool}}"
                                        ToolTip="{DynamicResource GroupsTestAllTooltip}" />
                                <ToggleButton x:Name="GroupsCollapseToggle"
                                              IsChecked="{Binding IsGroupsCollapsed}"
                                              FontSize="11"
                                              Padding="6,1"
                                              Margin="4,0,0,0"
                                              Content="▲▼"
                                              ToolTip="{DynamicResource GroupsCollapseTooltip}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource GroupsTitle}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <ToggleButton IsChecked="{Binding SortNodesByLatency}"
                                              FontSize="11"
                                              Padding="6,1"
                                              Margin="0,0,6,0"
                                              Content="{DynamicResource GroupsSortByLatency}" />
                                <ToggleButton IsChecked="{Binding ShowLatencyHistory}"
                                              FontSize="11"
                                              Padding="6,1"
                                              Margin="0,0,6,0"
                                              Content="{DynamicResource GroupsLatencyHistory}" />
                                <ToggleButton IsChecked="{Binding ShowHiddenProxyGroups}"
                                              FontSize="11"
                                              Padding="6,1"
                                              Content="{DynamicResource GroupsShowHidden}" />
                                <ToggleButton IsChecked="{Binding HideUnavailableProxyNodes}"
                                              FontSize="11"
                                              Padding="6,1"
                                              Margin="6,0,0,0"
                                              Content="{DynamicResource GroupsHideUnavailable}" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl x:Name="ProxyGroupsList"
                                      ItemsSource="{Binding Groups}"
                                      Visibility="{Binding IsGroupsCollapsed, Converter={StaticResource InverseBoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Margin="2,4,2,0"
                                              Padding="4,2"
                                              BorderBrush="#DDD"
                                              BorderThickness="1"
                                              IsExpanded="{Binding IsExpanded}">
                                        <Expander.Header>
                                            <DockPanel Margin="0,2">
                                                <Button DockPanel.Dock="Right"
                                                        Content="{DynamicResource GroupTest}"
                                                        Padding="8,1"
                                                        Margin="6,0,0,0"
                                                        FontSize="11"
                                                        Command="{Binding TestGroupCommand}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding DelayText}"
                                                           Foreground="#5E6B78"
                                                           FontSize="11"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding CurrentNode}"
                                                           Foreground="#5E6B78"
                                                           FontSize="11"
                                                           Margin="10,0,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="220"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <!-- 分组图标（源：proxyGroupLeadingIcon——URL 直载，加载失败静默） -->
                                                <Image Source="{Binding GroupIcon}"
                                                       Width="16" Height="16"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Stretch="Uniform" />
                                            </DockPanel>
                                        </Expander.Header>
                                        <!-- 节点行：类型徽章 + 名称 + 信号条 + 延迟 + 单节点测速 -->
                                        <ItemsControl ItemsSource="{Binding Nodes}" Margin="6,2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,1">
                                                        <Button DockPanel.Dock="Right"
                                                                Content="⚡"
                                                                Padding="4,0"
                                                                Margin="6,0,0,0"
                                                                FontSize="11"
                                                                ToolTip="{DynamicResource GroupTest}"
                                                                Command="{Binding DataContext.TestNodeCommand, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                CommandParameter="{Binding}" />
                                                        <!-- 延迟历史信号条（源：LatencySignalBars——5 槽右对齐、高度随延迟、颜色分好坏） -->
                                                        <ItemsControl DockPanel.Dock="Right"
                                                                      ItemsSource="{Binding SignalBars}"
                                                                      Visibility="{Binding HasSignalBars, Converter={StaticResource BoolToVis}}"
                                                                      Margin="8,0,0,0"
                                                                      VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Rectangle Width="2"
                                                                               Height="{Binding Height}"
                                                                               RadiusX="0.75"
                                                                               RadiusY="0.75"
                                                                               Margin="0,0,1.5,0"
                                                                               Fill="{Binding ColorHex}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding DelayText}"
                                                                   Foreground="#5E6B78"
                                                                   FontSize="11"
                                                                   MinWidth="52"
                                                                   TextAlignment="Right"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock DockPanel.Dock="Left"
                                                                   Text="{Binding NodeType}"
                                                                   Foreground="#8A93A0"
                                                                   FontSize="10"
                                                                   MinWidth="72"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   Cursor="Hand"
                                                                   Background="Transparent"
                                                                   Padding="2,1">
                                                            <TextBlock.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick"
                                                                              Command="{Binding DataContext.SwitchNodeCommand, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                              CommandParameter="{Binding}" />
                                                            </TextBlock.InputBindings>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                            <Setter Property="Foreground" Value="#0B6BCB" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- 规则（M4-1）：列表（目标/类型/策略/规则集统计）+ 类型过滤 + 搜索 + 策略分组 -->
            <TabItem Header="{DynamicResource TabRules}">
                <DockPanel x:Name="RulesRoot" Margin="4,8,4,4">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right"
                                Content="{DynamicResource RulesRefreshProviders}"
                                Padding="10,2"
                                Margin="10,0,0,0"
                                FontSize="11"
                                Command="{Binding RefreshCommand}" />
                        <ToggleButton DockPanel.Dock="Right"
                                      Content="{DynamicResource RulesGroupByPolicy}"
                                      Padding="10,2"
                                      FontSize="11"
                                      IsChecked="{Binding GroupByPolicy}" />
                        <TextBlock Text="{Binding StatsText}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <ComboBox DockPanel.Dock="Right"
                                  Width="110"
                                  Margin="8,0,0,0"
                                  ItemsSource="{Binding PolicyOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding PolicySelection}" />
                        <ComboBox DockPanel.Dock="Right"
                                  Width="84"
                                  ItemsSource="{Binding TypeFilterOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding TypeFilter}" />
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Padding="6,2"
                                 Margin="0,0,8,0" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding CountText}"
                               Foreground="#5E6B78"
                               FontSize="11"
                               Margin="0,0,0,4" />
                    <!-- 规则覆写（M4-1b：内嵌卡片——「列表是查看，覆写是操作」；源 OverrideTabView） -->
                    <Border DockPanel.Dock="Bottom"
                            x:Name="OverrideCardRoot"
                            Margin="0,6,0,0"
                            Padding="8"
                            BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="#FAFAFA">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right"
                                          Content="{DynamicResource NetworkSystemProxyEnable}"
                                          FontSize="12"
                                          IsChecked="{Binding IsEnabled}" />
                                <TextBlock Text="{DynamicResource OverrideTitle}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding DisabledHint}"
                                       Foreground="#5E6B78"
                                       FontSize="10"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Margin="0,6,0,0"
                                        Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}">
                                <!-- 三文件区行（同一时间只展开一个） -->
                                <Button Command="{Binding ToggleFileCommand}"
                                        CommandParameter="{x:Static overrides:RuleOverrideFile.Prepend}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="2,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↑" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource OverridePrependHint}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Foreground="#5E6B78" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"><Run Text="{Binding Counts.Prepend, Mode=OneWay}" /><Run Text="{DynamicResource OverrideCountEntries}" /></TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ToggleFileCommand}"
                                        CommandParameter="{x:Static overrides:RuleOverrideFile.Append}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="2,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↓" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource OverrideAppendHint}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Foreground="#5E6B78" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"><Run Text="{Binding Counts.Append, Mode=OneWay}" /><Run Text="{DynamicResource OverrideCountEntries}" /></TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ToggleFileCommand}"
                                        CommandParameter="{x:Static overrides:RuleOverrideFile.RuleProviders}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="2,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="≡" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource OverrideRuleSetsHint}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Foreground="#5E6B78" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"><Run Text="{Binding Counts.RuleProviders, Mode=OneWay}" /><Run Text="{DynamicResource OverrideCountSets}" /></TextBlock>
                                    </StackPanel>
                                </Button>
                                <!-- 编辑器（展开时显示，固定高 180；源：PlainTextEditor editorHeight） -->
                                <Grid Margin="0,6,0,0"
                                      Visibility="{Binding HasExpandedFile, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox Text="{Binding CurrentDraft, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             FontFamily="Consolas, Microsoft YaHei UI"
                                             FontSize="12"
                                             Height="180"
                                             Background="White"
                                             BorderBrush="#CCC" />
                                    <StackPanel Grid.Row="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,4,0,0">
                                        <Button Content="{DynamicResource OverrideRevert}"
                                                Padding="10,2"
                                                FontSize="11"
                                                Margin="0,0,8,0"
                                                Command="{Binding RevertCommand}"
                                                IsEnabled="{Binding IsDirty}" />
                                        <Button Content="{DynamicResource NetworkBypassSave}"
                                                Padding="10,2"
                                                FontSize="11"
                                                Command="{Binding SaveCommand}"
                                                IsEnabled="{Binding IsDirty}" />
                                    </StackPanel>
                                </Grid>
                                <!-- 状态行 -->
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Text="{Binding StatusText}"
                                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#1B7F3B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusLevel}" Value="error">
                                                    <Setter Property="Foreground" Value="#C0392B" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusLevel}" Value="info">
                                                    <Setter Property="Foreground" Value="#5E6B78" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- 操作按钮 -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Padding="10,2"
                                            FontSize="11"
                                            MinWidth="88"
                                            HorizontalAlignment="Left"
                                            Command="{Binding ApplyNowCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="{DynamicResource OverrideApplyNow}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsApplying}" Value="True">
                                                        <Setter Property="Content" Value="{DynamicResource CommonProcessing}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{DynamicResource OverrideOpenFolder}"
                                            Padding="10,2"
                                            FontSize="11"
                                            Margin="8,0,0,0"
                                            Command="{Binding OpenFolderCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type core:RuleGroupHeaderViewModel}">
                                    <Button Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Policy}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="2,4"
                                            Margin="0,4,0,2">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Foreground="#5E6B78"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="{Binding Policy, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="· " Foreground="#5E6B78" /><Run Text="{Binding Count, Mode=OneWay}" Foreground="#5E6B78" /><Run Text="{DynamicResource OverrideCountEntries}" Foreground="#5E6B78" />
                                            </TextBlock>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type core:RuleRowViewModel}">
                                    <Border Padding="2,4" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Target}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TypeText}"
                                                           Foreground="#8A93A0"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PolicyText}"
                                                       FontSize="11"
                                                       Foreground="#5E6B78"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding StatsText}"
                                                       FontSize="11"
                                                       Foreground="#8A93A0"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- 连接（M3-1/M3-4）：列表（host/规则/链路/上下行速率）+ 三维度流量统计 -->
            <TabItem Header="{DynamicResource TabConnections}">
                <Grid x:Name="ConnectionsRoot" Margin="4,8,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 视图切换：连接 / 统计（源：connectionsStore.showsStatistics segmented） -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton GroupName="ConnectionView"
                                     Content="{DynamicResource ConnectionsListTab}"
                                     IsChecked="True"
                                     FontSize="12"
                                     VerticalAlignment="Center" />
                        <RadioButton GroupName="ConnectionView"
                                     Content="{DynamicResource ConnectionsStatsTab}"
                                     IsChecked="{Binding ShowsStatistics}"
                                     Margin="12,0,0,0"
                                     FontSize="12"
                                     VerticalAlignment="Center" />
                        <ComboBox Width="76"
                                  Margin="16,0,0,0"
                                  ItemsSource="{Binding DimensionOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding StatisticsDimension}"
                                  Visibility="{Binding ShowsStatistics, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding StatisticsHint}"
                                   Foreground="#8A93A0"
                                   FontSize="10"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding ShowsStatistics, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <Border Grid.Row="1"
                            Visibility="{Binding ShowsList, Converter={StaticResource BoolToVis}}"
                            BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="#FAFAFA"
                            Padding="8">
                    <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right"
                                Content="{DynamicResource ConnectionsCloseAll}"
                                Padding="8,2"
                                Margin="8,0,0,0"
                                FontSize="11"
                                Command="{Binding CloseAllConnectionsCommand}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding SummaryText}"
                                   Foreground="#5E6B78"
                                   FontSize="11"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                        <ToggleButton DockPanel.Dock="Right"
                                      Content="{DynamicResource ConnectionsSortDesc}"
                                      Padding="8,2"
                                      Margin="8,0,0,0"
                                      FontSize="11"
                                      IsChecked="{Binding IsSortDescending}" />
                        <ComboBox DockPanel.Dock="Right"
                                  Width="104"
                                  Margin="8,0,0,0"
                                  ItemsSource="{Binding SortKeyOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SortKey}" />
                        <ComboBox DockPanel.Dock="Left"
                                  Width="76"
                                  ItemsSource="{Binding TransportFilterOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding TransportFilter}" />
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Padding="6,2"
                                 Margin="8,0,8,0" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ConnectionsList" ItemsSource="{Binding Connections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4,5" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right"
                                                    Content="✕"
                                                    Padding="5,0"
                                                    Margin="8,0,0,0"
                                                    FontSize="11"
                                                    ToolTip="{DynamicResource ConnectionsCloseOne}"
                                                    Command="{Binding CloseConnectionCommand}"
                                                    CommandParameter="{Binding}" />
                                            <StackPanel>
                                                <!-- 行1：host + 规则 -->
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Text="{Binding Rule}"
                                                               Foreground="#5E6B78"
                                                               FontSize="11"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Host}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <!-- 行2：时间 / 网络 / ↑速率 / ↓速率 / ↑累计 / ↓累计 -->
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Started}" Foreground="#5E6B78" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Network}" Foreground="#5E6B78" FontSize="11" Margin="10,0,0,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding UploadRate}" FontSize="11" Foreground="#0B6BCB" Margin="10,0,0,0" />
                                                    <TextBlock Grid.Column="3" Text="{Binding DownloadRate}" FontSize="11" Foreground="#1B7F3B" Margin="10,0,0,0" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Upload}" FontSize="11" Foreground="#8A93A0" Margin="10,0,0,0" TextAlignment="Right" />
                                                    <TextBlock Grid.Column="5" Text="{Binding Download}" FontSize="11" Foreground="#8A93A0" Margin="10,0,0,0" TextAlignment="Right" />
                                                </Grid>
                                                <!-- 行3：链路 -->
                                                <TextBlock Text="{Binding Chain}"
                                                           Foreground="#8A93A0"
                                                           FontSize="10"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </DockPanel>
                    </Border>
                    <!-- 统计视图（源：TrafficStatisticsView——名称/合计/上下行；与列表同卡片化） -->
                    <Border Grid.Row="1"
                            Visibility="{Binding ShowsStatistics, Converter={StaticResource BoolToVis}}"
                            BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="#FAFAFA"
                            Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding StatisticsRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4,5" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal"
                                                        MinWidth="200">
                                                <TextBlock Text="{DynamicResource ConnectionsTotal}"
                                                           FontSize="10"
                                                           Foreground="#8A93A0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding TotalText}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding UploadText}"
                                                           FontSize="11"
                                                           Foreground="#0B6BCB"
                                                           Margin="16,0,0,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DownloadText}"
                                                           FontSize="11"
                                                           Foreground="#1B7F3B"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 日志（M3-2）：mihomo WS 流 + 等级过滤 + 搜索 + 渲染上限；
                 定稿=表格化（时间/来源/等级/消息四列、彩色徽章、斑马纹、行悬停、表头吸顶、胶囊过滤） -->
            <TabItem Header="{DynamicResource TabLogs}">
                <DockPanel x:Name="LogsRoot" Margin="4,8,4,4">
                    <DockPanel.Resources>
                        <!-- 过滤胶囊（源：日志页 chip——圆角 99；选中=彩色边框/文字/浅底） -->
                        <ControlTemplate x:Key="FilterChipTemplate" TargetType="ToggleButton">
                            <Border x:Name="ChipBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="99"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ChipBorder" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                        <Style x:Key="FilterChipBase" TargetType="ToggleButton">
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Padding" Value="10,2" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                            <Setter Property="Foreground" Value="#5E6B78" />
                            <Setter Property="BorderBrush" Value="#CDD4DC" />
                            <Setter Property="Background" Value="White" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template" Value="{StaticResource FilterChipTemplate}" />
                        </Style>
                        <Style x:Key="ChipMihomoStyle" TargetType="ToggleButton" BasedOn="{StaticResource FilterChipBase}">
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="#2563EB" />
                                    <Setter Property="BorderBrush" Value="#2563EB" />
                                    <Setter Property="Background" Value="#1A2563EB" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="ChipClashBarStyle" TargetType="ToggleButton" BasedOn="{StaticResource FilterChipBase}">
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="#5E6B78" />
                                    <Setter Property="BorderBrush" Value="#5E6B78" />
                                    <Setter Property="Background" Value="#1A5E6B78" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="ChipErrorStyle" TargetType="ToggleButton" BasedOn="{StaticResource FilterChipBase}">
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="#C0392B" />
                                    <Setter Property="BorderBrush" Value="#C0392B" />
                                    <Setter Property="Background" Value="#1AC0392B" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="ChipWarningStyle" TargetType="ToggleButton" BasedOn="{StaticResource FilterChipBase}">
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="#B45309" />
                                    <Setter Property="BorderBrush" Value="#B45309" />
                                    <Setter Property="Background" Value="#1AB45309" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="ChipInfoStyle" TargetType="ToggleButton" BasedOn="{StaticResource FilterChipBase}">
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="#1B7F3B" />
                                    <Setter Property="BorderBrush" Value="#1B7F3B" />
                                    <Setter Property="Background" Value="#1A1B7F3B" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Resources>
                    <!-- 过滤栏：来源/等级胶囊 + 搜索 + 等级快捷 + 动作 -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right"
                                Content="{DynamicResource LogsClear}"
                                Padding="10,2"
                                MinWidth="52"
                                Margin="6,0,0,0"
                                FontSize="11"
                                Command="{Binding ClearAllCommand}" />
                        <Button DockPanel.Dock="Right"
                                Content="{DynamicResource LogsCopyAll}"
                                Padding="10,2"
                                FontSize="11"
                                Click="OnCopyLogsClick" />
                        <!-- 内核日志等级快捷入口（源：日志页级别菜单直接改内核设置） -->
                        <ComboBox DockPanel.Dock="Right"
                                  Width="90"
                                  Margin="6,0,0,0"
                                  FontSize="11"
                                  ItemsSource="{Binding LogLevelOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding LogLevel}" />
                        <TextBox DockPanel.Dock="Right"
                                 Width="160"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Padding="6,2" />
                        <!-- 来源过滤（源：logsSourceFilterButtons——空集 = 全部） -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton Content="Mihomo"
                                          Style="{StaticResource ChipMihomoStyle}"
                                          IsChecked="{Binding IsMihomoSourceSelected}" />
                            <ToggleButton Content="ClashBarX"
                                          Style="{StaticResource ChipClashBarStyle}"
                                          IsChecked="{Binding IsClashBarSourceSelected}" />
                            <Rectangle Width="1" Height="16" Fill="#D9DEE4" Margin="4,0,10,0" />
                            <ToggleButton Content="{DynamicResource LogsLevelError}"
                                          Style="{StaticResource ChipErrorStyle}"
                                          IsChecked="{Binding IsErrorSelected}" />
                            <ToggleButton Content="{DynamicResource LogsLevelWarning}"
                                          Style="{StaticResource ChipWarningStyle}"
                                          IsChecked="{Binding IsWarningSelected}" />
                            <ToggleButton Content="{DynamicResource LogsLevelInfo}"
                                          Style="{StaticResource ChipInfoStyle}"
                                          IsChecked="{Binding IsInfoSelected}" />
                            <TextBlock Text="{Binding MatchedCountText}"
                                       Foreground="#5E6B78"
                                       FontSize="11"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                    <!-- 日志表格卡：表头吸顶（表头在滚动区外） + 斑马纹 + 行悬停 -->
                    <Border BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="White">
                        <DockPanel>
                            <Border DockPanel.Dock="Top"
                                    Background="#F7F8FA"
                                    BorderBrush="#E4E7EB"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,6,12,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource LogsColTime}" FontSize="10.5" Foreground="#8A93A0" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource LogsColSource}" FontSize="10.5" Foreground="#8A93A0" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{DynamicResource LogsColLevel}" FontSize="10.5" Foreground="#8A93A0" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="{DynamicResource LogsColMessage}" FontSize="10.5" Foreground="#8A93A0" FontWeight="SemiBold" Margin="8,0,0,0" />
                                </Grid>
                            </Border>
                            <ListBox ItemsSource="{Binding VisibleLogs}"
                                     Background="White"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     AlternationCount="2">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="RowBorder"
                                                            Background="Transparent"
                                                            BorderBrush="#F0F2F5"
                                                            BorderThickness="0,0,0,1"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#FBFCFD" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#EEF4FF" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#E8F0FE" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 行四列：时间 | 来源徽章 | 等级徽章 | 消息（单行省略，悬停看全文） -->
                                        <Grid MinHeight="26">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Timestamp}"
                                                       FontFamily="Consolas, Microsoft YaHei UI"
                                                       FontSize="10.5"
                                                       Foreground="#8A93A0"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.Column="1"
                                                    CornerRadius="99"
                                                    Padding="8,1"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#1A5E6B78" />
                                                        <Setter Property="BorderBrush" Value="#4D5E6B78" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Source}" Value="Mihomo">
                                                                <Setter Property="Background" Value="#1A2563EB" />
                                                                <Setter Property="BorderBrush" Value="#4D2563EB" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Source}"
                                                           FontSize="10"
                                                           Foreground="#5E6B78">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Source}" Value="Mihomo">
                                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <Border Grid.Column="2"
                                                    CornerRadius="3"
                                                    Padding="8,1"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#1A1B7F3B" />
                                                        <Setter Property="BorderBrush" Value="#4D1B7F3B" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="error">
                                                                <Setter Property="Background" Value="#1AC0392B" />
                                                                <Setter Property="BorderBrush" Value="#4DC0392B" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="warning">
                                                                <Setter Property="Background" Value="#1AB45309" />
                                                                <Setter Property="BorderBrush" Value="#4DB45309" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Level}"
                                                           FontFamily="Consolas, Microsoft YaHei UI"
                                                           FontSize="10"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#1B7F3B" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="error">
                                                                    <Setter Property="Foreground" Value="#C0392B" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="warning">
                                                                    <Setter Property="Foreground" Value="#B45309" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Message}"
                                                       FontFamily="Consolas, Microsoft YaHei UI"
                                                       FontSize="11.5"
                                                       Foreground="#3B4048"
                                                       Margin="8,0,12,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Message}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>
            <!-- 网络（M4-2）：双列自然高（左=系统代理含绕过列表卡内滚动，右=守护+代理端口），
                 订阅全宽居底；外层滚动容忍任意窗口高度（真机教训：无外滚时超高内容会被后绘卡片盖住） -->
            <TabItem Header="{DynamicResource TabNetwork}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="4,8,4,4">
                    <!-- 双列自然高顶对齐（真机反馈：拉伸到视口高会在左列列表区留大片空白；紧凑优先） -->
                    <Grid Grid.Row="0" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- 左列：系统代理 + 绕过列表（源：SystemTabView 绕过区块 + 快捷开关） -->
                        <Border x:Name="SystemProxySectionRoot"
                                Grid.Column="0"
                                Padding="8"
                                BorderBrush="#DDD"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="#FAFAFA"
                                Margin="0,0,4,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0">
                                    <CheckBox DockPanel.Dock="Right"
                                              Content="{DynamicResource NetworkSystemProxyEnable}"
                                              FontSize="12"
                                              IsChecked="{Binding IsEnabled}" />
                                    <TextBlock Text="{DynamicResource NetworkSystemProxyTitle}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Grid.Row="1"
                                           Text="{DynamicResource NetworkBypassHint}"
                                           FontSize="11"
                                           Foreground="#5E6B78"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                                <!-- 绕过列表：卡内滚动（MaxHeight 控自然高，双列自然高对齐的前提；
                                     新增行固定卡底） -->
                                <ScrollViewer Grid.Row="2"
                                              VerticalScrollBarVisibility="Auto"
                                              MinHeight="60"
                                              MaxHeight="224"
                                              Margin="16,4,0,0">
                                    <ItemsControl ItemsSource="{Binding Exceptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,1">
                                                <Button DockPanel.Dock="Right"
                                                        Content="✕"
                                                        Padding="5,0"
                                                        FontSize="11"
                                                        ToolTip="{DynamicResource NetworkBypassRemove}"
                                                        Command="{Binding DataContext.RemoveExceptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="4,2"
                                                         VerticalContentAlignment="Center" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <DockPanel Grid.Row="3" Margin="16,4,0,0">
                                    <Button DockPanel.Dock="Right"
                                            Content="{DynamicResource NetworkBypassAdd}"
                                            Padding="8,1"
                                            FontSize="11"
                                            Command="{Binding AddExceptionCommand}"
                                            IsEnabled="{Binding CanAddException}" />
                                    <TextBox Text="{Binding NewException, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"
                                             Padding="4,2" />
                                </DockPanel>
                                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="16,8,0,0">
                                    <Button Content="{DynamicResource NetworkBypassReset}"
                                            Padding="10,2"
                                            FontSize="11"
                                            Margin="0,0,8,0"
                                            Command="{Binding ResetExceptionsCommand}" />
                                    <Button Content="{DynamicResource NetworkBypassSave}"
                                            Padding="10,2"
                                            FontSize="11"
                                            Command="{Binding SaveExceptionsCommand}"
                                            IsEnabled="{Binding HasPendingChanges}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- 右列：守护 + 代理端口卡（Mac systemTab 语义归位；自然高与左列配平） -->
                        <Grid Grid.Column="1" Margin="4,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        <!-- 自动代理守护（M3-3 区块挪入网络页；开关 + 周期 + 立即检查 + 结果反馈行） -->
                        <Border x:Name="GuardSettingsRoot"
                                Grid.Row="0"
                                Padding="8"
                                BorderBrush="#DDD"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="#FAFAFA"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding IsGuardEnabled}"
                                          Content="{DynamicResource NetworkGuardTitle}"
                                          FontWeight="SemiBold"
                                          FontSize="12" />
                                <StackPanel Margin="16,8,0,0"
                                            Visibility="{Binding IsGuardEnabled, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" Margin="0,8">
                                        <TextBlock Text="{DynamicResource NetworkGuardInterval}" VerticalAlignment="Center" FontSize="12" />
                                        <TextBox Text="{Binding IntervalText}"
                                                 Width="64"
                                                 Margin="8,0,0,0"
                                                 Padding="4,2"
                                                 VerticalContentAlignment="Center" />
                                    </StackPanel>
                                    <Button Margin="0,10,0,0"
                                            Padding="10,2"
                                            MinWidth="96"
                                            HorizontalAlignment="Left"
                                            Command="{Binding CheckNowCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="{DynamicResource GuardCheckNow}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProbing}" Value="True">
                                                        <Setter Property="Content" Value="{DynamicResource CommonChecking}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Margin="0,10,0,0"
                                               FontSize="12"
                                               Text="{Binding OutcomeText}"
                                               Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVis}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#1B7F3B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OutcomeLevel}" Value="warning">
                                                        <Setter Property="Foreground" Value="#B7791F" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding DisabledHint}"
                                           Foreground="#5E6B78"
                                           FontSize="11"
                                           Margin="16,8,0,0"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGuardEnabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <!-- 代理端口独立卡（源：Mac systemTabView 的 proxy_ports section；
                             750ms 防抖自动保存；单列右值；DataContext 经 code-behind 注入 CoreSettings） -->
                        <Border x:Name="ProxyPortsRoot"
                                Grid.Row="1"
                                Padding="8"
                                BorderBrush="#DDD"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="#FAFAFA">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SettingsProxyPorts}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource SettingsMixedPort}" FontSize="12" VerticalAlignment="Center" Margin="0,6,0,6" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MixedPortText, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" VerticalContentAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource SettingsHttpPort}" FontSize="12" VerticalAlignment="Center" Margin="0,6,0,6" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" VerticalContentAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource SettingsSocksPort}" FontSize="12" VerticalAlignment="Center" Margin="0,6,0,6" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SocksPortText, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" VerticalContentAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource SettingsRedirPort}" FontSize="12" VerticalAlignment="Center" Margin="0,6,0,6" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RedirPortText, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" VerticalContentAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource SettingsTproxyPort}" FontSize="12" VerticalAlignment="Center" Margin="0,6,0,6" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TproxyPortText, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" VerticalContentAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        </Grid>
                    </Grid>
                    
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 设置（M4-3）：双列（左=常规+维护，右=核心设置含端口，两列等高）；
                 关于与更新移出双列独占全宽（内部应用/内核并排 flex 1:1） -->
            <TabItem Header="{DynamicResource TabSettings}">
                <ScrollViewer x:Name="SettingsRoot" VerticalScrollBarVisibility="Auto" Margin="4,8,4,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        <!-- 左列：常规卡 + 维护卡（均自然高——真机反馈：拉伸维护卡凑底边对齐会留大片空白，
                             宁可两列底边略有参差也不在卡内留白） -->
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <Border Padding="8"
                                BorderBrush="#DDD"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="#FAFAFA">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsGeneralTitle}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,6" />
                            <DockPanel Margin="0,8">
                                <ComboBox DockPanel.Dock="Right"
                                          Width="150"
                                          ItemsSource="{Binding AppearanceOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding AppearanceMode}" />
                                <TextBlock Text="{DynamicResource SettingsAppearanceTitle}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Margin="0,8">
                                <ComboBox DockPanel.Dock="Right"
                                          Width="150"
                                          ItemsSource="{Binding LanguageOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Language}" />
                                <TextBlock Text="{DynamicResource SettingsLanguageTitle}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Margin="0,8">
                                <CheckBox DockPanel.Dock="Right"
                                          Content="{DynamicResource SettingsLaunchAtLoginHint}"
                                          FontSize="11"
                                          IsChecked="{Binding LaunchAtLogin}" />
                                <TextBlock Text="{DynamicResource SettingsLaunchAtLoginTitle}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{DynamicResource SettingsLaunchAtLoginFailed}"
                                       FontSize="11"
                                       Foreground="#C0392B"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding LaunchAtLoginFailed, Converter={StaticResource BoolToVis}}" />
                            <DockPanel Margin="0,8">
                                <CheckBox DockPanel.Dock="Right"
                                          Content="{DynamicResource SettingsTrafficOverviewShort}"
                                          FontSize="11"
                                          IsChecked="{Binding ShowTrafficOverview}" />
                                <TextBlock Text="{DynamicResource SettingsTrafficOverviewTitle}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                        </Border>
                        <!-- 维护卡（源：SystemTabView 维护区；GEO 热更新 + 内核自升级 + 应用更新检查；
                             小按钮 WrapPanel 排布；升级/检查反馈走对话框，卡内不留状态行） -->
                        <Border Padding="8"
                                Margin="0,10,0,0"
                                BorderBrush="#DDD"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="#FAFAFA">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Text="{DynamicResource SettingsMaintenance}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Margin="0,0,0,6" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="{DynamicResource AboutCheckUpdate}"
                                            Padding="8,2"
                                            Margin="0,0,6,10"
                                            FontSize="11"
                                            Command="{Binding CheckUpdateCommand}"
                                            IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBool}}" />
                                    <!-- 进行中状态按动作独立：升级内核时只有本按钮置灰并显示「执行中…」，GEO 等其余按钮不受联动 -->
                                    <Button Padding="8,2"
                                            Margin="0,0,6,10"
                                            FontSize="11"
                                            Command="{Binding UpgradeCoreCommand}"
                                            IsEnabled="{Binding IsUpgradingCore, Converter={StaticResource InverseBool}}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="{DynamicResource MaintenanceUpgradeCore}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUpgradingCore}" Value="True">
                                                        <Setter Property="Content" Value="{DynamicResource CommonProcessing}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Padding="8,2"
                                            Margin="0,0,6,10"
                                            FontSize="11"
                                            Command="{Binding UpgradeGeoCommand}"
                                            IsEnabled="{Binding IsUpdatingGeo, Converter={StaticResource InverseBool}}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="{DynamicResource MaintenanceUpdateGeo}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUpdatingGeo}" Value="True">
                                                        <Setter Property="Content" Value="{DynamicResource CommonProcessing}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Padding="8,2"
                                            Margin="0,0,6,10"
                                            FontSize="11"
                                            Command="{Binding FlushFakeIPCommand}"
                                            IsEnabled="{Binding IsFlushingFakeIp, Converter={StaticResource InverseBool}}"
                                            Content="{DynamicResource MaintenanceFlushFakeIP}" />
                                    <Button Padding="8,2"
                                            Margin="0,0,6,10"
                                            FontSize="11"
                                            Command="{Binding FlushDNSCommand}"
                                            IsEnabled="{Binding IsFlushingDns, Converter={StaticResource InverseBool}}"
                                            Content="{DynamicResource MaintenanceFlushDNS}" />
                                    <Button Padding="8,2"
                                            Margin="0,0,0,10"
                                            FontSize="11"
                                            Content="{DynamicResource MaintenanceOpenCoreDir}"
                                            Click="OnOpenCoreDirectoryClick" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                        <!-- 右列：核心设置卡 + SSID 策略卡（高度配平左列；PATCH /configs 即时生效） -->
                        <Grid Grid.Column="1" Margin="6,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Padding="8"
                                BorderBrush="#DDD"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="#FAFAFA"
                                DataContext="{Binding CoreSettings}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SettingsCoreSection}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Margin="0,0,0,6" />
                                <CheckBox Content="{DynamicResource SettingsAllowLan}"
                                          FontSize="12"
                                          IsChecked="{Binding AllowLan}" />
                                <CheckBox Content="IPv6"
                                          FontSize="12"
                                          Margin="0,12,0,0"
                                          IsChecked="{Binding Ipv6}" />
                                <CheckBox Content="{DynamicResource SettingsTcpConcurrent}"
                                          FontSize="12"
                                          Margin="0,12,0,0"
                                          IsChecked="{Binding TcpConcurrent}" />
                                <CheckBox Content="{DynamicResource SettingsCloseConnections}"
                                          FontSize="12"
                                          Margin="0,12,0,0"
                                          IsChecked="{Binding CloseConnections}" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="{DynamicResource SettingsLogLevel}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <ComboBox Width="110"
                                              Margin="10,0,0,0"
                                              ItemsSource="{Binding LogLevelOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding LogLevel}" />
                                </StackPanel>

                            </StackPanel>
                        </Border>
                        <!-- SSID 策略（M5-3：源 ProxyTabView 的 ssidStrategy 快捷项——开关 + 当前 SSID + 绑定管理；
                             设置页右列第二卡——Mac 的 ssidStrategy 设置语义归位） -->
                        <Border x:Name="SsidStrategyRoot"
                                Grid.Row="1"
                                Padding="8"
                                Margin="0,8,0,0"
                                BorderBrush="#DDD"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="#FAFAFA">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right"
                                              Content="{DynamicResource SsidStrategyToggle}"
                                              FontSize="12"
                                              IsChecked="{Binding IsEnabled}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource SsidStrategyTitle}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CurrentSsidText}"
                                                   FontSize="11"
                                                   Foreground="#5E6B78"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{DynamicResource SsidStrategyHint}"
                                           FontSize="11"
                                           Foreground="#5E6B78"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Bindings}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <Button DockPanel.Dock="Right"
                                                        Content="✕"
                                                        Padding="5,0"
                                                        FontSize="11"
                                                        ToolTip="{DynamicResource SsidStrategyUnbind}"
                                                        Click="OnSsidUnbindClick" />
                                                <TextBlock FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="#5E6B78">
                                                    <Run Text="{Binding Ssid}" FontWeight="SemiBold" />
                                                    <Run Text=" → " />
                                                    <Run Text="{Binding ConfigFileName}" />
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="{DynamicResource SsidStrategyBindCurrent}"
                                        FontSize="11"
                                        Padding="10,4"
                                        ToolTip="{DynamicResource SsidEmptyHint}"
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        IsEnabled="{Binding IsEnabled}"
                                        Click="OnSsidBindCurrentClick" />
                            </StackPanel>
                        </Border>
                        </Grid>
                    </Grid>

                    <!-- 订阅管理（M2-3：Boss 定稿挪入设置页全宽行；远程目标时整体只读） -->
                    <Border x:Name="SubscriptionSectionRoot"
                            Grid.Row="1"
                            Padding="8"
                            Margin="0,8,0,0"
                            BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="#FAFAFA">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock x:Name="RemoteReadonlyHint"
                                           DockPanel.Dock="Right"
                                           Text="{DynamicResource MachineRemoteReadonly}"
                                           FontSize="11"
                                           Foreground="#B45309"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                                <TextBlock Text="{DynamicResource NetworkSubscriptionTitle}"
                                           FontWeight="SemiBold"
                                           FontSize="12" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button x:Name="ImportLocalButton"
                                        DockPanel.Dock="Right"
                                        Content="{DynamicResource NetworkSubscriptionImportLocal}"
                                        Padding="10,2"
                                        MinWidth="60"
                                        Margin="6,0,0,0"
                                        ToolTip="{DynamicResource NetworkSubscriptionImportLocalHint}"
                                        Click="OnImportLocalClick" />
                                <Button x:Name="ImportButton"
                                        DockPanel.Dock="Right"
                                        Content="{DynamicResource NetworkSubscriptionImport}"
                                        Padding="10,2"
                                        MinWidth="60"
                                        ToolTip="{DynamicResource NetworkSubscriptionImportHint}"
                                        Click="OnImportClick" />
                                <TextBox x:Name="SubscriptionUrlBox"
                                         VerticalContentAlignment="Center"
                                         Padding="4,2" />
                            </DockPanel>
                            <ListBox x:Name="ConfigFilesBox"
                                     MinHeight="72"
                                     MaxHeight="120" />
                            <!-- 说明与四按钮同一行（定稿——说明左置、按钮组右置） -->
                            <DockPanel Margin="0,6,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <!-- 远程订阅更新（源：ProxyTabView 订阅行刷新/更新全部） -->
                                    <Button Content="{DynamicResource SubscriptionUpdate}"
                                            Padding="10,2"
                                            MinWidth="60"
                                            Margin="0,0,8,0"
                                            Click="OnRefreshSubscriptionClick" />
                                    <Button Content="{DynamicResource SubscriptionUpdateAll}"
                                            Padding="10,2"
                                            MinWidth="72"
                                            Margin="0,0,8,0"
                                            Click="OnRefreshAllSubscriptionsClick" />
                                    <Button Content="{DynamicResource NetworkSubscriptionEnable}"
                                            Padding="10,2"
                                            MinWidth="60"
                                            Margin="0,0,8,0"
                                            Click="OnEnableClick" />
                                    <Button Content="{DynamicResource NetworkSubscriptionRemove}"
                                            Padding="10,2"
                                            MinWidth="60"
                                            Click="OnRemoveClick" />
                                </StackPanel>
                                <TextBlock Text="{DynamicResource SubscriptionButtonsHint}"
                                           FontSize="11"
                                           Foreground="#5E6B78"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    
                                            
                </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        </DockPanel>
    </DockPanel>
    </Border>
</Window>
