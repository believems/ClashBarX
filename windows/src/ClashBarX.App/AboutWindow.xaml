<Window x:Class="ClashBarX.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AboutWindowTitle}"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource ThemeWindowBrush}">
    <!-- 关于对话框（应用菜单「关于 ClashBarX」的落点）：设置页关于卡 1.0.0 定稿移除后，
         版本信息统一在此展示。数据目录放只读文本框便于复制，发布页按钮直达 GitHub releases -->
    <StackPanel Margin="22,20,22,18">
        <TextBlock Text="ClashBarX for Windows"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ThemeTextBrush}" />
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{DynamicResource AboutAppVersionLabel}"
                       FontSize="12" Margin="0,0,18,8"
                       Foreground="{DynamicResource ThemeTextBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AppVersionText"
                       FontSize="12" Margin="0,0,0,8"
                       Foreground="{DynamicResource ThemeTextBrush}" />
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{DynamicResource AboutKernelVersionLabel}"
                       FontSize="12" Margin="0,0,18,8"
                       Foreground="{DynamicResource ThemeTextBrush}" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="KernelVersionText"
                       FontSize="12" Margin="0,0,0,8"
                       Foreground="{DynamicResource ThemeTextBrush}" />
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="{DynamicResource AboutActiveConfigLabel}"
                       FontSize="12" Margin="0,0,18,0"
                       Foreground="{DynamicResource ThemeTextBrush}" />
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ActiveConfigText"
                       FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource ThemeTextBrush}" />
        </Grid>
        <TextBlock Text="{DynamicResource AboutDataDirLabel}"
                   FontSize="12"
                   Margin="0,4,0,4"
                   Foreground="{DynamicResource ThemeTextBrush}" />
        <Border Padding="8,4"
                Background="{DynamicResource ThemeSurfaceBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="3">
            <TextBox x:Name="DataDirectoryBox"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"
                     FontFamily="Consolas"
                     FontSize="12"
                     Foreground="{DynamicResource ThemeTextBrush}"
                     VerticalContentAlignment="Center" />
        </Border>
        <!-- 打开发布页失败时的行内反馈（同引导对话框的口径） -->
        <TextBlock x:Name="StatusText"
                   FontSize="11"
                   Foreground="{DynamicResource ThemeErrorBrush}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{DynamicResource AboutOpenRelease}"
                    ToolTip="{DynamicResource AboutVersionTooltip}"
                    Padding="12,4"
                    Margin="0,0,8,0"
                    Click="OnOpenReleasePageClick" />
            <Button Content="{DynamicResource AboutClose}"
                    Padding="12,4"
                    MinWidth="72"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
