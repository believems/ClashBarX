<Window x:Class="ClashBarX.App.CoreSetupGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource GuideCoreTitle}"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource ThemeWindowBrush}">
    <!-- 无内核安装引导（源：app.core.setup_required）：说明 no-core 策略与内核获取方式，
         一键打开内核目录 / 发布页；目录路径放在只读文本框里便于复制 -->
    <StackPanel Margin="22,20,22,18">
        <TextBlock Text="{DynamicResource GuideCoreIntro}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource ThemeTextBrush}" />
        <TextBlock Text="{DynamicResource GuideCoreStep1}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Margin="0,10,0,0"
                   Foreground="{DynamicResource ThemeTextBrush}" />
        <TextBlock Text="{DynamicResource GuideCoreStep2}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource ThemeTextBrush}" />
        <Border Margin="0,6,0,0"
                Padding="8,4"
                Background="{DynamicResource ThemeSurfaceBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="3">
            <TextBox x:Name="CoreDirectoryBox"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"
                     FontFamily="Consolas"
                     FontSize="12"
                     Foreground="{DynamicResource ThemeTextBrush}"
                     VerticalContentAlignment="Center" />
        </Border>
        <TextBlock Text="{DynamicResource GuideCoreStep3}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource ThemeTextBrush}" />
        <!-- 打开目录/发布页失败时的行内反馈 -->
        <TextBlock x:Name="StatusText"
                   FontSize="11"
                   Foreground="{DynamicResource ThemeErrorBrush}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{DynamicResource GuideCoreOpenReleasePage}"
                    Padding="12,4"
                    Margin="0,0,8,0"
                    Click="OnOpenReleasePageClick" />
            <Button Content="{DynamicResource GuideCoreOpenDirectory}"
                    Padding="12,4"
                    Margin="0,0,8,0"
                    Click="OnOpenCoreDirectoryClick" />
            <Button Content="{DynamicResource GuideCoreClose}"
                    Padding="12,4"
                    MinWidth="72"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
